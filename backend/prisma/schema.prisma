generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum ItemStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

enum ItemCondition {
  NEW
  GOOD
  DAMAGED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  BORROWED
  RETURNED
  OVERDUE
}

// Lifecycle of an equipment reservation:
//   PENDING   -> borrower submitted, waiting for a decision
//   APPROVED  -> staff accepted it, slot is held for the pickup date
//   REJECTED  -> staff declined it (or it failed conflict re-check on approve)
//   CANCELLED -> borrower withdrew their own pending request
//   EXPIRED   -> not picked up within RESERVATION_GRACE_DAYS after the pickup date
//   COMPLETED -> collected at the desk and converted into a Loan
enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(STUDENT)
  department    String?
  isBlacklisted Boolean  @default(false)
  penaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  loans         Loan[]
  decisions     Loan[]   @relation("DecidedBy")
  reservations  Reservation[]
  reservationDecisions Reservation[] @relation("ReservationDecider")

  @@index([role])
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  icon        String
  description String?
  items       Item[]
}

model Item {
  id                Int           @id @default(autoincrement())
  code              String        @unique
  name              String
  description       String?
  categoryId        Int
  category          Category      @relation(fields: [categoryId], references: [id])
  totalQuantity     Int
  availableQuantity Int
  condition         ItemCondition @default(GOOD)
  status            ItemStatus    @default(AVAILABLE)
  department        String?
  imageUrl          String?
  createdAt         DateTime      @default(now())
  loans             Loan[]
  reservations      Reservation[]

  @@index([categoryId])
  @@index([status])
}

model Loan {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  itemId         Int
  item           Item          @relation(fields: [itemId], references: [id])
  quantity       Int
  purpose        String
  dateNeeded     DateTime
  returnDate     DateTime
  status         RequestStatus @default(PENDING)
  remarks        String?
  outcome        String?
  decidedById    Int?
  decidedBy      User?         @relation("DecidedBy", fields: [decidedById], references: [id])
  borrowedAt     DateTime?
  returnedAt     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([status])
  @@index([userId])
  @@index([itemId])
}

// A reservation holds a future (or currently-out) item for a borrower.
// reservationDate is the PICKUP date (stored at local midnight, date-only);
// pickupTime is the preferred time of day on that date as "HH:MM".
// returnDate is when it must come back, mirroring Loan.returnDate so the
// existing overdue cron handles converted reservations unchanged.
model Reservation {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id])
  itemId          Int
  item            Item              @relation(fields: [itemId], references: [id])
  quantity        Int               @default(1)
  reservationDate DateTime
  pickupTime      String?
  returnDate      DateTime
  purpose         String
  status          ReservationStatus @default(PENDING)
  remarks         String?
  decidedById     Int?
  decidedBy       User?             @relation("ReservationDecider", fields: [decidedById], references: [id])
  loanId          Int?
  pickedUpAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([userId])
  @@index([itemId])
  @@index([reservationDate])
}
