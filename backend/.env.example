# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/equipment_db?schema=public"

# API server
PORT=4000

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Required when running the seed script; use a private password of at least 16 characters
SEED_USER_PASSWORD=

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN="http://localhost:5173"

# Registration is restricted to emails ending with this domain (leave empty to disable)
SCHOOL_EMAIL_DOMAIN="@school.edu"

# SMTP settings for email reminders (leave SMTP_HOST empty to log emails to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Equipment Desk <no-reply@school.edu>"

# Where uploaded equipment images are stored (relative to backend folder)
UPLOAD_DIR="uploads"
